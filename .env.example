# ==============================================================================
# SismoWatch — Archivo de Ejemplo de Variables de Entorno (.env.example)
# Copiar a .env antes de ejecutar: cp .env.example .env
# NOTA DE SEGURIDAD: Todos los valores aquí son de ejemplo. NUNCA subir .env a Git.
# ==============================================================================

# --- 1. Base de Datos PostgreSQL (Principal y Metadatos de Airflow) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sismowatch
POSTGRES_USER=sismowatch_master
POSTGRES_PASSWORD=CHANGE_ME_master_db_pass_example

# --- 2. Roles de Base de Datos con Mínimo Privilegio (Sección 7) ---
# Rol para ingesta: escribe únicamente en el schema raw
DB_INGEST_USER=ingest_role
DB_INGEST_PASSWORD=CHANGE_ME_ingest_role_pass_example

# Rol para transformación: lee raw, escribe en staging y curated
DB_TRANSFORM_USER=transform_role
DB_TRANSFORM_PASSWORD=CHANGE_ME_transform_role_pass_example

# Rol para IA: lee curated, escribe en anomalies, daily_reports, ai_runs, kb_chunks
DB_AI_USER=ai_role
DB_AI_PASSWORD=CHANGE_ME_ai_role_pass_example

# Rol de solo lectura para consultas de la API y SQL seguro del agente (solo SELECT en curated)
DB_READER_USER=reader_role
DB_READER_PASSWORD=CHANGE_ME_reader_role_pass_example

# Rol de escritura mínima para la API: solo escribe en curated.ai_cache y sesiones
DB_API_RW_USER=api_rw_role
DB_API_RW_PASSWORD=CHANGE_ME_api_rw_role_pass_example

# --- 3. Data Lake MinIO (S3 Compatible) ---
MINIO_ROOT_USER=sismowatch_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret_example
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# --- 4. Apache Airflow (Orquestación y API REST) ---
# Generar clave Fernet real con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AIRFLOW_SECRET_KEY=CHANGE_ME_airflow_webserver_secret_example
AIRFLOW_ADMIN_USER=sismowatch_airflow
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_airflow_admin_pass_example
AIRFLOW_ADMIN_EMAIL=admin@superapp.local
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1
AIRFLOW_API_USER=sismowatch_airflow
AIRFLOW_API_PASSWORD=CHANGE_ME_airflow_admin_pass_example

# --- 5. Seguridad y Autenticación de la API (FastAPI + JWT + Semilla de Usuarios) ---
JWT_SECRET=CHANGE_ME_jwt_signing_secret_32_chars_min_example
JWT_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_portal_pass_example
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=CHANGE_ME_viewer_portal_pass_example
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- 6. Inteligencia Artificial (Groq + Ollama Local + Caché) ---
# Proveedor primario: groq | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here_optional
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://ollama:11434
OLLAMA_FALLBACK_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_KEEP_ALIVE=2m
AI_CACHE_TTL=3600

# --- 7. Alertas y Observabilidad ---
# URL de Webhook (Slack / Telegram / Discord / HTTP receptor) para on_failure_callback
ALERT_WEBHOOK_URL=http://api:8000/api/internal/webhook-sink

# --- 8. Umbrales de Calidad de Datos (Compuerta por Lote) ---
# Latencia máxima permitida del lote en minutos (24h = 1440 para tolerar feeds tranquilos o backfills)
FRESHNESS_MAX_MINUTES=180
# Volumen mínimo y máximo de eventos por ejecución
VOLUME_MIN=0
VOLUME_MAX=25000
# Ratio máximo de filas inválidas permitido antes de bloquear el lote (0.20 = 20%)
INVALID_RATIO_MAX=0.20

# --- 9. Parámetros de Ingesta USGS ---
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_QUERY_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
BACKFILL_DEFAULT_DAYS=30
BACKFILL_MIN_MAGNITUDE=2.5

# --- 10. Gobernanza y Catálogo de Datos (OpenMetadata) ---
OPENMETADATA_URL=http://openmetadata-server:8585/api
OPENMETADATA_ADMIN_EMAIL=admin@open-metadata.org
OPENMETADATA_ADMIN_PASSWORD=admin
OM_DB_NAME=openmetadata_db
OM_DB_USER=openmetadata_user
OM_DB_PASSWORD=CHANGE_ME_om_db_pass_example
